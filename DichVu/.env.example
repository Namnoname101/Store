# Database (SQLite)
DATABASE_URL="file:./dev.db"

# Mã ngân hàng nhận tiền. Các mã hỗ trợ:
# MB (MBBank), VCB (Vietcombank), TCB (Techcombank), ACB,
# VPB (VPBank), TPB (TPBank), BIDV, VietinBank
BANK_ID=MB

# Số tài khoản ngân hàng của bạn
BANK_ACCOUNT_NO=0987654321

# Tên chủ tài khoản (Viết in hoa không dấu)
BANK_ACCOUNT_NAME=NGUYEN VAN A

# ========================================================
# CỔNG THANH TOÁN TỰ ĐỘNG (SEPAY / PAYOS / CASSO)
# ========================================================
# Secret key xác thực webhook (Nếu có cấu hình trên cổng)
PAYMENT_WEBHOOK_SECRET=secret_token_here
