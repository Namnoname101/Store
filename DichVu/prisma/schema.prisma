generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// In SQLite, enums are represented as strings with defaults.
// TypeScript enum helpers are exported from src/lib/prisma.ts.

model User {
  id                 String              @id @default(uuid())
  username           String?             @unique
  email              String?             @unique
  passwordHash       String?
  name               String?
  role               String              @default("CUSTOMER") // Role: CUSTOMER, ADMIN
  balance            Int                 @default(0)          // Số dư ví VND (>= 0)
  totalDeposited     Int                 @default(0)          // Tổng tiền đã nạp lũy kế
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  orders             Order[]
  depositOrders      DepositOrder[]
  walletTransactions WalletTransaction[]
  codexBindings      CustomerApiKeyBinding[]
}

model Category {
  id          String    @id @default(uuid())
  name        String
  slug        String    @unique
  description String?
  products    Product[]
  createdAt   DateTime  @default(now())
}

model Product {
  id            String        @id @default(uuid())
  title         String
  slug          String        @unique
  description   String
  price         Int           // VND
  originalPrice Int?          // VND
  type          String        @default("LICENSE_KEY") // ProductType: LICENSE_KEY, ACCOUNT, COURSE_LINK
  thumbnailUrl    String?
  isActive        Boolean                 @default(true)
  categoryId      String
  category        Category                @relation(fields: [categoryId], references: [id])
  fulfillmentType String                  @default("LOCAL_STOCK") // FulfillmentType: LOCAL_STOCK, API_DROPSHIP
  minQuantity     Int                     @default(1)
  maxQuantity     Int?
  supplierMapping SupplierProductMapping?
  items           ProductItem[]
  orderItems      OrderItem[]
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
}

model ProductItem {
  id            String      @id @default(uuid())
  productId     String
  product       Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  secretContent String      // Key, credentials (email|pass), or link
  status        String      @default("AVAILABLE") // ItemStatus: AVAILABLE, RESERVED, SOLD
  orderId       String?
  order         Order?      @relation(fields: [orderId], references: [id])
  reservedUntil DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model Order {
  id                  String               @id @default(uuid())
  orderCode           String               @unique // e.g. ORD849201
  accessToken         String?              @unique @default(uuid()) // Secure access token for guest order lookup
  idempotencyKey      String?              @unique // Prevent duplicate order creations
  customerEmail       String?
  customerNote        String?              // e.g. Link video/profile for SMM services
  userId              String?
  user                User?                @relation(fields: [userId], references: [id])
  totalAmount         Int                  // VND
  subtotalAmount      Int                  @default(0) // Gross amount before discount
  discountAmount      Int                  @default(0) // Discount VND subtracted
  couponId            String?
  coupon              Coupon?              @relation(fields: [couponId], references: [id])
  status              String               @default("PENDING") // OrderStatus: PENDING, PAID, CANCELLED, EXPIRED
  paymentMethod       String               @default("VIETQR")
  reconciliationStatus String?             // ReconciliationStatus: MATCHED, UNDERPAID, OVERPAID, MISMATCH_MEMO, EXPIRED_PAYMENT, MANUAL_RESOLVED
  reconciliationNote   String?
  reconciledAt        DateTime?
  reconciledBy        String?              // "SYSTEM" | "OWNER"
  upstreamStatus      String               @default("NOT_APPLICABLE") // UpstreamStatus: NOT_APPLICABLE, PENDING_UPSTREAM, COMPLETED, FAILED, REFUNDED
  upstreamOrderId     String?
  upstreamError       String?
  refundInfo          String?              // Bank account info for refunds
  refundStatus        String?              // REFUND_REQUESTED, REFUND_PENDING, REFUNDED
  refundProof         String?              // Bank transfer reference/txId or proof note
  refundedAt          DateTime?
  expiresAt           DateTime
  paidAt              DateTime?
  orderItems          OrderItem[]
  deliveredItems      ProductItem[]
  transactions        PaymentTransaction[]
  paymentIntents      PaymentIntent[]
  creditTopupOrder    CreditTopupOrder?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
}

model PaymentIntent {
  id         String   @id @default(uuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  intentCode String   @unique // e.g. PI_ORD849201_1
  qrUrl      String
  amount     Int      // VND
  expiresAt  DateTime // Exactly 10 minutes from creation
  status     String   @default("ACTIVE") // ACTIVE, EXPIRED, PAID, SUPERSEDED, CANCELLED
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Coupon {
  id            String    @id @default(uuid())
  code          String    @unique // Normalized uppercase
  type          String    @default("FIXED") // CouponType: FIXED, PERCENT
  value         Int       // VND or percent
  minOrderValue Int       @default(0) // VND
  maxDiscount   Int?      // Max discount VND ceiling for percent
  usageLimit    Int?      // Max total uses
  usedCount     Int       @default(0)
  expiresAt     DateTime?
  isActive      Boolean   @default(true)
  orders        Order[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Supplier {
  id             String                   @id @default(uuid())
  name           String                   // e.g. "Taphoammo.net", "Trumthe.vn"
  code           String                   @unique // e.g. "TAPHOAMMO"
  type           String                   @default("CUSTOM_REST") // SupplierType: TAPHOAMMO, TRUMTHE, CUSTOM_REST
  baseUrl        String
  apiKey         String
  apiSecret      String?
  currentBalance Int                      @default(0) // Số dư tài khoản đại lý (VND)
  isActive       Boolean                  @default(true)
  mappings       SupplierProductMapping[]
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
}

model SupplierProductMapping {
  id                  String   @id @default(uuid())
  productId           String   @unique
  product             Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  supplierId          String
  supplier            Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  supplierProductCode String   // Mã/ID sản phẩm bên sàn nguồn
  supplierPrice       Int      // Giá vốn (VND) cập nhật lần cuối
  supplierStock       Int      @default(0) // Số lượng tồn kho sàn nguồn cập nhật lần cuối
  markupType          String   @default("PERCENTAGE") // MarkupType: PERCENTAGE, FIXED_AMOUNT
  markupValue         Float    // e.g. 20 (cho 20%) hoặc 15000 (cho +15.000đ)
  isAutoSync          Boolean  @default(true)
  customConfig        String?  // JSON metadata for multi-supplier routing & alternative sources
  lastSyncAt          DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model OrderItem {
  id           String   @id @default(uuid())
  orderId      String
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId    String
  product      Product  @relation(fields: [productId], references: [id])
  price        Int
  quantity     Int
  targetLink   String?  // Link kênh / video / profile riêng của từng sản phẩm SMM
  customerNote String?  // Ghi chú riêng theo từng item
}

model PaymentTransaction {
  id                   String        @id @default(uuid())
  orderId              String?
  order                Order?        @relation(fields: [orderId], references: [id])
  depositOrderId       String?
  depositOrder         DepositOrder? @relation(fields: [depositOrderId], references: [id])
  transactionId        String        @unique // Mã giao dịch ngân hàng / gateway
  amount               Int
  bankCode             String?
  content              String?
  rawPayload           String?
  reconciliationStatus String?       @default("MATCHED") // MATCHED, UNDERPAID, OVERPAID, MISMATCH_MEMO, EXPIRED_PAYMENT, MANUAL_RESOLVED, UNMATCHED_ORDER
  reconciliationNote   String?
  refundStatus         String?       // REFUND_PENDING, REFUNDED
  refundProof          String?       // Mã giao dịch ngân hàng hoàn tiền
  refundedAt           DateTime?
  resolvedAt           DateTime?
  resolvedBy           String?       // "OWNER"
  createdAt            DateTime      @default(now())
}

model AuditLog {
  id          String   @id @default(uuid())
  action      String   // RECONCILE_MATCH, RECONCILE_REFUND, RECONCILE_DISMISS, OVERRIDE_FULFILLMENT
  entityType  String   // ORDER, TRANSACTION, PAYMENT_INTENT
  entityId    String
  details     String?  // JSON string of changes / notes
  performedBy String   @default("OWNER")
  createdAt   DateTime @default(now())
}

model DepositOrder {
  id           String               @id @default(uuid())
  depositCode  String               @unique // Ví dụ: NAP582914
  userId       String
  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount       Int                  // Số tiền nạp VND (tối thiểu 20.000 VND)
  status       String               @default("PENDING") // PENDING | COMPLETED | EXPIRED | CANCELLED
  expiresAt    DateTime             // Hết hạn sau 30 phút
  paidAt       DateTime?
  transactions PaymentTransaction[]
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@index([depositCode])
  @@index([userId])
}

model WalletTransaction {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type          String   // TOPUP | ORDER_PAYMENT | REFUND | ADMIN_ADJUST
  amount        Int      // Số tiền thay đổi (+nạp, -thanh toán)
  balanceBefore Int      // Số dư trước biến động
  balanceAfter  Int      // Số dư sau biến động
  referenceId   String?  // Mã đơn hàng (ORD...) hoặc mã nạp (NAP...) liên quan
  description   String   // Diễn giải giao dịch
  createdAt     DateTime @default(now())

  @@index([userId])
  @@index([referenceId])
}

model LocketAutoConfig {
  id              String    @id @default("default")
  goldPassUrl     String    // Full URL GoldPass
  passId          String    // Trích xuất từ URL (tham số ?p=)
  linkVersion     Int       @default(1) // Tham số ?v=
  signature       String    // Tham số ?t=
  sessionCookie   String    // Cookie đăng nhập tài khoản Yuicsa
  csrfToken       String?   // CSRF token nếu đối tác yêu cầu
  targetUsername  String?   // @qthinh0106
  isActive        Boolean   @default(false) // Trạng thái bật/tắt Auto 24/7
  intervalSeconds Int       @default(60)    // Khoảng cách giữa các lần kích
  lastRunAt       DateTime? // Lần kích gần nhất
  lastStatus      String?   // SUCCESS | COOLDOWN | FAILED | SESSION_EXPIRED
  lastMessage     String?   // Chi tiết phản hồi từ đối tác
  updatedAt       DateTime  @updatedAt
  createdAt       DateTime  @default(now())
}

model LocketAutoLog {
  id          String   @id @default(uuid())
  status      String   // SUCCESS | COOLDOWN | FAILED | SESSION_EXPIRED
  jobId       String?  // Mã job nhận từ đối tác nếu có
  message     String   // Mô tả kết quả
  rawPayload  String?  // JSON response từ đối tác
  durationMs  Int?     // Thời gian phản hồi mạng (ms)
  createdAt   DateTime @default(now())

  @@index([createdAt])
}

model CustomerApiKeyBinding {
  id               String            @id @default(uuid())
  userId           String?           // Khách đăng nhập (User.id)
  user             User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  guestEmail       String?           // Khách vãng lai
  upstreamTokenId  Int               @unique // ID token trên modelapi.vn (Bắt buộc unique để 1 token chỉ thuộc 1 khách)
  keyFingerprint   String            @unique // HMAC-SHA256 của chuỗi sk-... (dùng để tìm kiếm mà không lưu plain text key)
  maskedKey        String            // sk-abc...xyz (dùng để hiển thị UI)
  keyName          String?           // Tên gợi nhớ của key trên ModelAPI
  status           String            @default("ACTIVE") // ACTIVE, DISABLED
  totalCreditUsd   Float             @default(0) // Tổng USD đã nạp lũy kế qua DaiTruong
  lastSyncedAt     DateTime?
  topupOrders      CreditTopupOrder[]
  ledgerEntries    CreditLedger[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([userId])
  @@index([keyFingerprint])
}

model CreditTopupOrder {
  id              String                @id @default(uuid())
  orderId         String                @unique
  order           Order                 @relation(fields: [orderId], references: [id], onDelete: Cascade)
  bindingId       String
  binding         CustomerApiKeyBinding @relation(fields: [bindingId], references: [id], onDelete: Cascade)
  creditUsd       Float                 // Gói credit khách mua (USD, ví dụ 10.0)
  quotaUnits      Int                   // Quota tương ứng (ví dụ: 5.000.000)
  status          String                @default("PENDING") // PENDING, PROCESSING, COMPLETED, RECONCILE_REQUIRED, FAILED
  errorMessage    String?
  retryCount      Int                   @default(0)
  completedAt     DateTime?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  @@index([bindingId])
  @@index([status])
}

model CreditLedger {
  id                 String                @id @default(uuid())
  bindingId          String
  binding            CustomerApiKeyBinding @relation(fields: [bindingId], references: [id], onDelete: Cascade)
  topupOrderId       String?
  upstreamTokenId    Int
  quotaBefore        Int                   // Quota đọc từ modelapi trước khi nạp
  quotaAddedExpected Int                   // Quota dự kiến cộng thêm
  quotaAfterReported Int                   // Quota đọc lại sau khi update
  discrepancyDelta   Int                   @default(0) // Độ lệch nếu key tiêu thụ AI trong lúc nạp
  performedBy        String                @default("SYSTEM") // SYSTEM, OWNER
  note               String?
  createdAt          DateTime              @default(now())

  @@index([bindingId])
  @@index([upstreamTokenId])
}

model ModelApiSyncSnapshot {
  id               String   @id @default(uuid())
  sourceQuotaTotal Int      // Quota tài khoản tổng modelapi.vn
  sourceQuotaUsed  Int
  sourceBalanceUsd Float
  totalCustomerObligationQuota Int // Tổng quota còn lại của tất cả key cửa hàng cấp
  status           String   @default("HEALTHY") // HEALTHY, WARNING_LOW_BALANCE, CRITICAL
  createdAt        DateTime @default(now())
}

