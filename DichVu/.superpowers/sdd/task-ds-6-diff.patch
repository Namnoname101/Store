+import { describe, it, expect, beforeAll, afterAll, beforeEach } from "vitest";
+import {
+  prisma,
+  SupplierType,
+  MarkupType,
+  UpstreamStatus,
+  OrderStatus,
+  FulfillmentType,
+} from "@/lib/prisma";
+import { MockSupplierAdapter } from "@/services/suppliers/adapters/mock.adapter";
+import {
